pragma solidity ^0.8.28;
import {Test} from "forge-std/Test.sol";
import {BabyBearReference as Ref} from "./helpers/BabyBearReference.sol";
import {BabyFusedRowHarness, BabyUnfusedRowHarness, KoalaFusedRowHarness, KoalaUnfusedRowHarness} from "./helpers/FusedRows.sol";
interface IFusedRow {
function batch(bytes calldata,uint256[4] memory,uint256,uint256,uint256,uint256) external view returns(uint256,uint256,uint256,bytes32);
function dot(uint256[16] memory,uint256[16] memory,uint256,uint256) external view returns(uint256,uint256);
}
contract FusedRowsTest is Test {
IFusedRow[4] h;
function setUp() external {h[0]=IFusedRow(address(new KoalaUnfusedRowHarness()));h[1]=IFusedRow(address(new KoalaFusedRowHarness()));h[2]=IFusedRow(address(new BabyUnfusedRowHarness()));h[3]=IFusedRow(address(new BabyFusedRowHarness()));}
function packed(bytes32 seed,uint256 index,uint256 p) private pure returns(uint256) {uint256[5] memory a;for(uint256 j;j<5;++j)a[j]=uint256(keccak256(abi.encode(seed,index,j)))%p;return Ref.pack(a);}
function blobFor(bytes32 seed,uint256 count,uint256 p) private pure returns(bytes memory blob){blob=new bytes(count*320+32);for(uint256 i;i<count*16;++i){uint256 a=packed(seed,i,p);assembly("memory-safe"){mstore(add(add(blob,32),mul(i,20)),a)}}assembly("memory-safe"){mstore(blob,mul(count,320))}}
function oracle(bytes memory blob,uint256[4] memory point,uint256 claim,uint256 challenge,uint256 ood,uint256 p,uint256 f,bool combine) external pure returns(uint256 result,bytes32 digest){
uint256[16] memory weights;for(uint256 i;i<16;++i){uint256 w=uint256(1)<<224;for(uint256 j;j<4;++j){uint256 term=((i>>(3-j))&1)!=0?point[j]:Ref.add(uint256(1)<<224,Ref.scale(point[j],p-1,p),p);w=Ref.mul(w,term,p,f);}weights[i]=w;}
result=claim;bytes memory leaf=new bytes(321);for(uint256 k=blob.length/320;k>0;--k){uint256 row;for(uint256 i;i<16;++i){uint256 a;assembly("memory-safe"){a:=and(mload(add(add(blob,32),add(mul(sub(k,1),320),mul(i,20)))),not(sub(shl(96,1),1)))}row=Ref.add(row,Ref.mul(a,weights[i],p,f),p);}for(uint256 i;i<320;++i)leaf[i+1]=blob[(k-1)*320+i];digest^=bytes32(bytes20(keccak256(leaf)));result=combine?Ref.add(Ref.mul(result,challenge,p,f),row,p):result^row;}
if(combine)result=Ref.add(Ref.mul(result,challenge,p,f),ood,p);
}
function checkChain(bytes memory blob,uint256[4] memory point,uint256 claim,uint256 challenge,uint256 ood,uint256 p,uint256 f,bool combine) private view{
(uint256 expected,bytes32 hash)=this.oracle(blob,point,claim,challenge,ood,p,f,combine);for(uint256 i=2*f;i<2*f+2;++i){(,,uint256 actual,bytes32 digest)=h[i].batch(blob,point,blob.length/320,claim,challenge,ood);assertEq(actual,expected,"schoolbook chain order");assertEq(digest,hash,"prefixed row hashes");assertEq(actual&((uint256(1)<<96)-1),0);for(uint256 c;c<5;++c)assertLt((actual>>(224-32*c))&0xffffffff,p);}}
function testFuzzChainOracle(bytes32 seed) external view {for(uint256 f;f<2;++f){uint256 p=f==0?0x7f000001:0x78000001;uint256[4] memory point;for(uint256 j;j<4;++j)point[j]=packed(seed,j,p);bytes memory blob=blobFor(seed,3,p);checkChain(blob,point,packed(seed,200,p),packed(seed,201,p),packed(seed,202,p),p,f,true);}}
function testFuzzDot17(bytes32 seed) external view {for(uint256 f;f<2;++f){uint256 p=f==0?0x7f000001:0x78000001;uint256[16] memory a;uint256[16] memory b;uint256 claim=packed(seed,32,p);uint256 challenge=packed(seed,33,p);uint256 expected=Ref.mul(claim,challenge,p,f);for(uint256 i;i<16;++i){a[i]=packed(seed,i,p);b[i]=packed(seed,i+16,p);expected=Ref.add(expected,Ref.mul(a[i],b[i],p,f),p);}for(uint256 j=2*f;j<2*f+2;++j){(,uint256 actual)=h[j].dot(a,b,claim,challenge);assertEq(actual,expected,"17 arbitrary dense products");}}}
function testMaximalAndBasis17() external view {for(uint256 f;f<2;++f){uint256 p=f==0?0x7f000001:0x78000001;uint256[16] memory a;uint256[16] memory b;uint256 max=Ref.pack([p-1,p-1,p-1,p-1,p-1]);for(uint256 i;i<16;++i){a[i]=max;b[i]=max;}uint256 expected=Ref.scale(Ref.mul(max,max,p,f),17,p);for(uint256 j=2*f;j<2*f+2;++j){(,uint256 actual)=h[j].dot(a,b,max,max);assertEq(actual,expected,"maximal 17 products");}for(uint256 x;x<5;++x)for(uint256 y;y<5;++y){uint256 claim=(p-1)<<(224-32*x);uint256 challenge=(p-1)<<(224-32*y);expected=Ref.add(Ref.scale(Ref.mul(max,max,p,f),16,p),Ref.mul(claim,challenge,p,f),p);(,uint256 actual)=h[2*f+1].dot(a,b,claim,challenge);assertEq(actual,expected,"maximal dot and basis claim");}}}
function testZeroOneMaximalChains() external view {for(uint256 f;f<2;++f){uint256 p=f==0?0x7f000001:0x78000001;uint256 max=Ref.pack([p-1,p-1,p-1,p-1,p-1]);uint256[4] memory point=[max,max,max,max];bytes memory blob=blobFor(bytes32(uint256(9)),3,p);uint256[3] memory edges=[uint256(0),uint256(1)<<224,max];for(uint256 i;i<3;++i)for(uint256 j;j<3;++j)checkChain(blob,point,edges[i],edges[j],max,p,f,true);}}
function testMalformedEveryLaneAndFirstError() external {uint256[4] memory point;for(uint256 f;f<2;++f){uint256 p=f==0?0x7f000001:0x78000001;uint256[4] memory bads=[p,p+1,uint256(0x80000000),uint256(0xffffffff)];for(uint256 element;element<16;++element)for(uint256 lane;lane<5;++lane)for(uint256 k;k<4;++k){bytes memory blob=new bytes(352);uint256 bad=bads[k]<<(224-32*lane);assembly("memory-safe"){mstore(blob,320)mstore(add(add(blob,32),mul(element,20)),bad)}for(uint256 i=2*f;i<2*f+2;++i){vm.expectRevert(abi.encodeWithSelector(bytes4(0xd53cfe5c),bad));h[i].batch(blob,point,1,0,0,0);}}bytes memory blob=new bytes(352);uint256 first=uint256(0xffffffff)<<224;uint256 second=uint256(0x80000000)<<96;assembly("memory-safe"){mstore(blob,320)mstore(add(blob,72),first)mstore(add(blob,312),second)}for(uint256 i=2*f;i<2*f+2;++i){vm.expectRevert(abi.encodeWithSelector(bytes4(0xd53cfe5c),first));h[i].batch(blob,point,1,0,0,0);}}}
function testBenchmarkFullWorkload() external {string[4] memory names=["KoalaUnfused","KoalaFused","BabyUnfused","BabyFused"];uint256[4] memory point;for(uint256 j;j<4;++j)point[j]=packed(bytes32(uint256(67)),j,0x78000001);uint256[3] memory counts=[uint256(31),19,14];for(uint256 i;i<4;++i){uint256 total;for(uint256 r;r<2;++r){bytes memory blob=blobFor(bytes32(uint256(73+r)),counts[r],0x78000001);(uint256 setup,uint256 rows,uint256 value,bytes32 digest)=h[i].batch(blob,point,counts[r],0,packed(bytes32(uint256(91+r)),0,0x78000001),packed(bytes32(uint256(93+r)),1,0x78000001));emit log_named_uint(string.concat(names[i],".setup",vm.toString(counts[r])),setup);emit log_named_uint(string.concat(names[i],".rows",vm.toString(counts[r])),rows);total+=setup+rows;assertTrue(value!=0&&digest!=0);}emit log_named_uint(string.concat(names[i],".total"),total);}}
function testComplete31And19ChainOracle() external view {for(uint256 f;f<2;++f){uint256 p=f==0?0x7f000001:0x78000001;uint256[4] memory point;for(uint256 j;j<4;++j)point[j]=packed(bytes32(uint256(111)),j,p);for(uint256 r;r<2;++r)checkChain(blobFor(bytes32(uint256(73+r)),r==0?31:19,p),point,0,packed(bytes32(uint256(91+r)),0,p),packed(bytes32(uint256(93+r)),1,p),p,f,true);}}
}
