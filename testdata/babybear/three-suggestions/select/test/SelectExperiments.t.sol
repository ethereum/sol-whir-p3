pragma solidity ^0.8.28;
import {Test} from "forge-std/Test.sol";
import {BabyBearReference as Ref} from "./helpers/BabyBearReference.sol";
import {BabyBearChainBaselineHarness,BabyBearChainPackedHornerHarness,BabyBearChainPersistentUHarness,BabyBearChainFusedConsumerHarness,BabyBearChainFusedConsumerPackedHornerHarness,KoalaBearChainBaselineHarness,KoalaBearChainPackedHornerHarness,KoalaBearChainPersistentUHarness,KoalaBearChainFusedConsumerHarness,KoalaBearChainFusedConsumerPackedHornerHarness,BabyBearChainFusedConsumerFinalDirectHarness,KoalaBearChainFusedConsumerFinalDirectHarness} from "./helpers/SelectExperiments.sol";
interface H {function batch(uint256[] memory,uint256[][3] memory,uint256[3] memory,uint256[3] memory) external view returns(uint256,uint256[3] memory);function chains(uint256[] memory,uint256,uint256,uint256,uint256) external view returns(uint256,uint256,uint256);}
contract SelectExperimentsTest is Test {H[12] h;uint256 constant Q=0x78000001;uint256 constant P=0x7f000001;
function setUp() external {h[11]=H(address(new KoalaBearChainFusedConsumerFinalDirectHarness()));h[10]=H(address(new BabyBearChainFusedConsumerFinalDirectHarness()));h[0]=H(address(new BabyBearChainBaselineHarness()));h[1]=H(address(new BabyBearChainPackedHornerHarness()));h[2]=H(address(new BabyBearChainPersistentUHarness()));h[3]=H(address(new BabyBearChainFusedConsumerHarness()));h[4]=H(address(new BabyBearChainFusedConsumerPackedHornerHarness()));h[5]=H(address(new KoalaBearChainBaselineHarness()));h[6]=H(address(new KoalaBearChainPackedHornerHarness()));h[7]=H(address(new KoalaBearChainPersistentUHarness()));h[8]=H(address(new KoalaBearChainFusedConsumerHarness()));h[9]=H(address(new KoalaBearChainFusedConsumerPackedHornerHarness()));}
function point(bytes32 seed,uint256 p) private pure returns(uint256[] memory v){v=new uint256[](22);for(uint256 i;i<22;++i){uint256[5] memory a;for(uint256 j;j<5;++j)a[j]=uint256(keccak256(abi.encode(seed,i,j)))%p;v[i]=Ref.pack(a);}}
function inputs(bytes32 seed,uint256 p) private pure returns(uint256[] memory v,uint256[][3] memory sels,uint256[3] memory ch,uint256[3] memory eq){v=point(seed,p);uint256[3] memory count=[uint256(38),31,19];for(uint256 r;r<3;++r){sels[r]=new uint256[](count[r]);for(uint256 i;i<count[r];++i)sels[r][i]=uint256(keccak256(abi.encode(r,i)))%p;ch[r]=v[r];eq[r]=v[r+3];}}
function testBenchmark() external{(uint256[] memory v,uint256[][3] memory sels,uint256[3] memory ch,uint256[3] memory eq)=inputs(bytes32(uint256(20260905)),Q);{(uint256 used,uint256[3] memory actual)=h[0].batch(v,sels,ch,eq);(,uint256[3] memory expected)=h[0].batch(v,sels,ch,eq);assertEq(abi.encode(actual),abi.encode(expected));emit log_named_uint("BabyBearChainBaseline",used);}
{(uint256 used,uint256[3] memory actual)=h[1].batch(v,sels,ch,eq);(,uint256[3] memory expected)=h[0].batch(v,sels,ch,eq);assertEq(abi.encode(actual),abi.encode(expected));emit log_named_uint("BabyBearChainPackedHorner",used);}
{(uint256 used,uint256[3] memory actual)=h[2].batch(v,sels,ch,eq);(,uint256[3] memory expected)=h[0].batch(v,sels,ch,eq);assertEq(abi.encode(actual),abi.encode(expected));emit log_named_uint("BabyBearChainPersistentU",used);}
{(uint256 used,uint256[3] memory actual)=h[3].batch(v,sels,ch,eq);(,uint256[3] memory expected)=h[0].batch(v,sels,ch,eq);assertEq(abi.encode(actual),abi.encode(expected));emit log_named_uint("BabyBearChainFusedConsumer",used);}
{(uint256 used,uint256[3] memory actual)=h[4].batch(v,sels,ch,eq);(,uint256[3] memory expected)=h[0].batch(v,sels,ch,eq);assertEq(abi.encode(actual),abi.encode(expected));emit log_named_uint("BabyBearChainFusedConsumerPackedHorner",used);}
{(uint256 used,uint256[3] memory actual)=h[5].batch(v,sels,ch,eq);(,uint256[3] memory expected)=h[5].batch(v,sels,ch,eq);assertEq(abi.encode(actual),abi.encode(expected));emit log_named_uint("KoalaBearChainBaseline",used);}
{(uint256 used,uint256[3] memory actual)=h[6].batch(v,sels,ch,eq);(,uint256[3] memory expected)=h[5].batch(v,sels,ch,eq);assertEq(abi.encode(actual),abi.encode(expected));emit log_named_uint("KoalaBearChainPackedHorner",used);}
{(uint256 used,uint256[3] memory actual)=h[7].batch(v,sels,ch,eq);(,uint256[3] memory expected)=h[5].batch(v,sels,ch,eq);assertEq(abi.encode(actual),abi.encode(expected));emit log_named_uint("KoalaBearChainPersistentU",used);}
{(uint256 used,uint256[3] memory actual)=h[8].batch(v,sels,ch,eq);(,uint256[3] memory expected)=h[5].batch(v,sels,ch,eq);assertEq(abi.encode(actual),abi.encode(expected));emit log_named_uint("KoalaBearChainFusedConsumer",used);}
{(uint256 used,uint256[3] memory actual)=h[9].batch(v,sels,ch,eq);(,uint256[3] memory expected)=h[5].batch(v,sels,ch,eq);assertEq(abi.encode(actual),abi.encode(expected));emit log_named_uint("KoalaBearChainFusedConsumerPackedHorner",used);}
{(uint256 used,uint256[3] memory actual)=h[10].batch(v,sels,ch,eq);(,uint256[3] memory expected)=h[0].batch(v,sels,ch,eq);assertEq(abi.encode(actual),abi.encode(expected));emit log_named_uint("BabyBearChainFusedConsumerFinalDirect",used);}{(uint256 used,uint256[3] memory actual)=h[11].batch(v,sels,ch,eq);(,uint256[3] memory expected)=h[5].batch(v,sels,ch,eq);assertEq(abi.encode(actual),abi.encode(expected));emit log_named_uint("KoalaBearChainFusedConsumerFinalDirect",used);}}
function testFuzzCompleteChains(bytes32 seed,uint256 a,uint256 b) external view {for(uint256 f;f<2;++f){uint256 p=f==0?Q:P;uint256[] memory v=point(seed,p);a%=p;b%=p;for(uint256 n=2;n<=18;n+=4){uint256 x=Ref.chain(a,v,22-n,n,p,f==0?1:0);uint256 y=Ref.chain(b,v,22-n,n,p,f==0?1:0);for(uint256 j;j<5;++j){(,uint256 ax,uint256 ay)=h[f*5+j].chains(v,a,b,22-n,n);assertEq(ax,x);assertEq(ay,y);}}}}
function testFuzzFullBatch(bytes32 seed) external view {for(uint256 f;f<2;++f){uint256 p=f==0?Q:P;(uint256[] memory v,uint256[][3] memory sels,uint256[3] memory ch,uint256[3] memory eq)=inputs(seed,p);uint256[3] memory expected;for(uint256 r;r<3;++r){uint256 n=18-4*r;for(uint256 i=sels[r].length;i>0;--i)expected[r]=Ref.add(Ref.mul(expected[r],ch[r],p,f==0?1:0),Ref.chain(sels[r][i-1],v,22-n,n,p,f==0?1:0),p);expected[r]=Ref.add(Ref.mul(expected[r],ch[r],p,f==0?1:0),eq[r],p);}for(uint256 j;j<5;++j){(,uint256[3] memory actual)=h[f*5+j].batch(v,sels,ch,eq);assertEq(abi.encode(actual),abi.encode(expected));}}}
function testBoundaryChainsAndBatch() external view {for(uint256 f;f<2;++f){uint256 p=f==0?Q:P;uint256 max=Ref.pack([p-1,p-1,p-1,p-1,p-1]);(uint256[] memory v,uint256[][3] memory sels,uint256[3] memory ch,uint256[3] memory eq)=inputs(bytes32(0),p);for(uint256 i;i<22;++i)v[i]=max;for(uint256 j;j<5;++j){for(uint256 n;n<=18;n+=9){(,uint256 x,uint256 y)=h[f*5+j].chains(v,0,p-1,22-n,n);assertEq(x,Ref.chain(0,v,22-n,n,p,f==0?1:0));assertEq(y,Ref.chain(p-1,v,22-n,n,p,f==0?1:0));}for(uint256 r;r<3;++r){for(uint256 i;i<sels[r].length;++i)sels[r][i]=i%2==0?0:p-1;ch[r]=max;eq[r]=max;}(,uint256[3] memory actual)=h[f*5+j].batch(v,sels,ch,eq);(,uint256[3] memory expected)=h[f*5].batch(v,sels,ch,eq);assertEq(abi.encode(actual),abi.encode(expected));}}}
}