        }
        total = _hornerStep(total, challenge, eqEval);
    }

    function _hornerStep(uint256 total, uint256 challenge, uint256 weight)
        internal
        pure
        returns (uint256)
    {
        return BabyBearBenchField.add(BabyBearBenchField.mul(total, challenge), weight);
    }
}

