contract BabyBearSelectCubicsPackedHornerHarness {
    function chains(uint256[] memory point, uint256 a, uint256 b, uint256 offset, uint256 n)
        external
        view
        returns (uint256 used, uint256 x, uint256 y)
    {
        require(point.length == 22 && offset >= 4 && offset <= 22 && n <= 22 - offset, "SHAPE");
        if (n % 2 != 0 || offset + n != 22) {
            uint256 t = gasleft();
            (x, y) = BabyBearSelectForms._selectPolyEvalFixedPair(
                a, b, BabyBearSelectPrepackedCombined.prepare(point), offset, n
            );
            return (t - gasleft(), x, y);
        }
        uint256 start = gasleft();
        uint256[] memory cache = BabyBearSelectCubicsPackedHorner.prepare(point);
        (x, y) = BabyBearSelectCubicsPackedHorner._selectPolyEvalFixedPair(a, b, cache, offset, n);
        used = start - gasleft();
    }

    function single(uint256[] memory point, uint256 a, uint256 offset, uint256 n)
        external
        pure
        returns (uint256)
    {
        require(point.length == 22 && offset >= 4 && offset <= 22 && n <= 22 - offset, "SHAPE");
        if (n % 2 != 0 || offset + n != 22) {
            return BabyBearSelectForms._selectPolyEvalFixed(
                a, BabyBearSelectPrepackedCombined.prepare(point), offset, n
            );
        }
        return BabyBearSelectCubicsPackedHorner._selectPolyEvalFixed(
            a, BabyBearSelectCubicsPackedHorner.prepare(point), offset, n
        );
    }

    function batch(
        uint256[] memory point,
        uint256[][3] memory selectors,
        uint256[3] memory challenges,
        uint256[3] memory eqs
    ) external view returns (uint256 used, uint256[3] memory result) {
        require(
            point.length == 22 && selectors[0].length == 38 && selectors[1].length == 31
                && selectors[2].length == 19,
            "SHAPE"
        );
        uint256 start = gasleft();
        uint256[] memory cache = BabyBearSelectCubicsPackedHorner.prepare(point);
        result[0] = BabyBearSelectCubicsPackedHorner._evaluateConstraintSelectRaw18WithPrecomputedEq(
            challenges[0], eqs[0], selectors[0], cache
        );
        result[1] = BabyBearSelectCubicsPackedHorner._evaluateConstraintSelectRaw14WithPrecomputedEq(
            challenges[1], eqs[1], selectors[1], cache
        );
        result[2] = BabyBearSelectCubicsPackedHorner._evaluateConstraintSelectRaw10WithPrecomputedEq(
            challenges[2], eqs[2], selectors[2], cache
        );
        used = start - gasleft();
    }
}

