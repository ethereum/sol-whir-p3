        uint256[] memory cache = KoalaBearSelectCubics.prepare(point);
        result[0] = KoalaBearSelectCubics._evaluateConstraintSelectRaw18WithPrecomputedEq(
            challenges[0], eqs[0], selectors[0], cache
        );
        result[1] = KoalaBearSelectCubics._evaluateConstraintSelectRaw14WithPrecomputedEq(
            challenges[1], eqs[1], selectors[1], cache
        );
        result[2] = KoalaBearSelectCubics._evaluateConstraintSelectRaw10WithPrecomputedEq(
