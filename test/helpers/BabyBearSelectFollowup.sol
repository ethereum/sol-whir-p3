            challenges[0], eqs[0], selectors[0], cache
        );
        result[1] = BabyBearSelectForms._evaluateConstraintSelectRaw14WithPrecomputedEq(
            challenges[1], eqs[1], selectors[1], cache
        );
        result[2] = BabyBearSelectForms._evaluateConstraintSelectRaw10WithPrecomputedEq(
            challenges[2], eqs[2], selectors[2], cache
        );
        used = start - gasleft();
    }
}

