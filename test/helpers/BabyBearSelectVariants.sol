library BabyBearSelectPrepackedCombined {
    function _selectPolyEvalFixed(
        uint256 var_,
        uint256[] memory fullPoint,
        uint256 pointOffset,
        uint256 numVariables
    ) internal pure returns (uint256 acc) {
        acc = BabyBearBenchField.ONE;
        uint256 current = var_;

        unchecked {
            uint256 i = numVariables;
            if (i != 0) {
                --i;
                uint256 scalar = current + (0x78000001 - 1);
                acc = _initialCached(_cachedAddress(fullPoint, pointOffset + i), scalar);
                current = mulmod(current, current, 0x78000001);
            }
            for (; i > 0; --i) {
                uint256 scalar = current + (0x78000001 - 1);
                acc = _mulBySelectTermCached(
                    acc, _cachedAddress(fullPoint, pointOffset + i - 1), scalar
                );
                current = mulmod(current, current, BabyBearBenchField.MODULUS);
            }
        }
    }

    function _selectPolyEvalFixedPair(
        uint256 var0,
        uint256 var1,
        uint256[] memory fullPoint,
        uint256 pointOffset,
        uint256 numVariables
    ) internal pure returns (uint256 acc0, uint256 acc1) {
        acc0 = BabyBearBenchField.ONE;
        acc1 = BabyBearBenchField.ONE;
        uint256 current0 = var0;
        uint256 current1 = var1;

        unchecked {
            uint256 i = numVariables;
            if (i != 0) {
                --i;
                uint256 pointValue = _cachedAddress(fullPoint, pointOffset + i);
                uint256 scalar0 = current0 + (0x78000001 - 1);
                uint256 scalar1 = current1 + (0x78000001 - 1);
                acc0 = _initialCached(pointValue, scalar0);
                acc1 = _initialCached(pointValue, scalar1);
                current0 = mulmod(current0, current0, 0x78000001);
                current1 = mulmod(current1, current1, 0x78000001);
            }
            for (; i > 0; --i) {
                uint256 pointValue = _cachedAddress(fullPoint, pointOffset + i - 1);
                uint256 scalar0 = current0 + (0x78000001 - 1);
                uint256 scalar1 = current1 + (0x78000001 - 1);
                acc0 = _mulBySelectTermCached(acc0, pointValue, scalar0);
                acc1 = _mulBySelectTermCached(acc1, pointValue, scalar1);
                current0 = mulmod(current0, current0, BabyBearBenchField.MODULUS);
                current1 = mulmod(current1, current1, BabyBearBenchField.MODULUS);
            }
        }
    }

    function _mulBySelectTermExt5(uint256 acc, uint256 pointValue, uint256 scalar)
        internal
        pure
        returns (uint256 out)
    {
        assembly ("memory-safe") {
            let M := 0x78000001
            let mask := 0xffffffff

            let low
            let high
            let c4
            {
                let a0 := shr(224, acc)
                let a1 := and(shr(192, acc), mask)
                let a2 := and(shr(160, acc), mask)
                let a3 := and(shr(128, acc), mask)
                let a4 := and(shr(96, acc), mask)
                let b0 := shr(224, pointValue)
                let b1 := and(shr(192, pointValue), mask)
                let b2 := and(shr(160, pointValue), mask)
                let b3 := and(shr(128, pointValue), mask)
                let b4 := and(shr(96, pointValue), mask)

                let aLow := or(or(a0, shl(64, a1)), or(shl(128, a2), shl(192, a3)))
                let bLow := or(or(b0, shl(64, b1)), or(shl(128, b2), shl(192, b3)))
                // Four middle terms fit in the top lane; the fifth is added separately.
                c4 := add(shr(192, mul(aLow, or(shr(64, bLow), shl(192, b4)))), mul(a4, b0))
                // The low four coefficients in each order have at most four terms.
                // Since 4 * (M - 1)^2 < 2^64, their 64-bit lanes cannot carry.
                low := mul(aLow, bLow)
                high := mul(
                    or(or(a4, shl(64, a3)), or(shl(128, a2), shl(192, a1))),
                    or(or(b4, shl(64, b3)), or(shl(128, b2), shl(192, b1)))
                )
            }
            let laneMask := 0xffffffffffffffff
            let c0 := and(low, laneMask)
            let c1 := and(shr(64, low), laneMask)
            let c2 := and(shr(128, low), laneMask)
            let c3 := shr(192, low)
            let c5 := shr(192, high)
            let c6 := and(shr(128, high), laneMask)
            let c7 := and(shr(64, high), laneMask)
            let c8 := and(high, laneMask)
            out := or(
                or(
                    or(
                        shl(224, mod(add(shr(224, acc), mul(scalar, add(c0, shl(1, c5)))), M)),
                        shl(
                            192,
                            mod(add(and(shr(192, acc), mask), mul(scalar, add(c1, shl(1, c6)))), M)
                        )
                    ),
                    or(
                        shl(
                            160,
                            mod(add(and(shr(160, acc), mask), mul(scalar, add(c2, shl(1, c7)))), M)
                        ),
                        shl(
                            128,
                            mod(add(and(shr(128, acc), mask), mul(scalar, add(c3, shl(1, c8)))), M)
                        )
                    )
                ),
                shl(96, mod(add(and(shr(96, acc), mask), mul(scalar, c4)), M))
            )
        }
    }

    function _evaluateConstraintSelectRaw18WithPrecomputedEq(
        uint256 challenge,
        uint256 eqEval,
        uint256[] memory selVars,
        uint256[] memory fullPoint
    ) internal pure returns (uint256 total) {
        unchecked {
            uint256 i = selVars.length;
            for (; i > 1;) {
                uint256 eval0;
                uint256 eval1;
                (eval0, eval1) =
                    _selectPolyEvalFixedPair(selVars[i - 1], selVars[i - 2], fullPoint, 4, 18);
                total = _hornerStep(total, challenge, eval0);
                total = _hornerStep(total, challenge, eval1);
                i -= 2;
            }
            if (i != 0) {
                total = _hornerStep(
                    total, challenge, _selectPolyEvalFixed(selVars[0], fullPoint, 4, 18)
                );
            }
        }
        total = _hornerStep(total, challenge, eqEval);
    }

    function _evaluateConstraintSelectRaw14WithPrecomputedEq(
        uint256 challenge,
        uint256 eqEval,
        uint256[] memory selVars,
        uint256[] memory fullPoint
    ) internal pure returns (uint256 total) {
        unchecked {
            uint256 i = selVars.length;
            for (; i > 1;) {
                uint256 eval0;
                uint256 eval1;
                (eval0, eval1) =
                    _selectPolyEvalFixedPair(selVars[i - 1], selVars[i - 2], fullPoint, 8, 14);
                total = _hornerStep(total, challenge, eval0);
                total = _hornerStep(total, challenge, eval1);
                i -= 2;
            }
            if (i != 0) {
                total = _hornerStep(
