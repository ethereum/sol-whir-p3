    }

    function _evaluateConstraintSelectRaw10WithPrecomputedEq(
        uint256 challenge,
        uint256 eqEval,
        uint256[] memory selVars,
        uint256[] memory fullPoint
    ) internal pure returns (uint256 total) {
        unchecked {
            uint256 i = selVars.length;
            for (; i > 1;) {
                uint256 eval0;
                uint256 eval1;
                (eval0, eval1) =
                    _selectPolyEvalFixedPair(selVars[i - 1], selVars[i - 2], fullPoint, 12, 10);
                total = _hornerStep(total, challenge, eval0);
                total = _hornerStep(total, challenge, eval1);
                i -= 2;
            }
            if (i != 0) {
                total = _hornerStep(
                    total, challenge, _selectPolyEvalFixed(selVars[0], fullPoint, 12, 10)
                );
            }
        }
        total = _hornerStep(total, challenge, eqEval);
    }

    function _hornerStep(uint256 total, uint256 challenge, uint256 weight)
        internal
        pure
        returns (uint256)
    {
        return BabyBearBenchField.add(BabyBearBenchField.mul(total, challenge), weight);
    }

    // Inputs are canonical; scalar may be <= 2*M-2. Outputs are canonical.
    function _initialSelect(uint256 point, uint256 scalar) private pure returns (uint256 out) {
        assembly ("memory-safe") {
            let M := 0x78000001
            out := or(
                or(
                    or(
                        shl(224, mod(add(1, mul(shr(224, point), scalar)), M)),
                        shl(192, mulmod(and(shr(192, point), 0xffffffff), scalar, M))
                    ),
                    or(
                        shl(160, mulmod(and(shr(160, point), 0xffffffff), scalar, M)),
                        shl(128, mulmod(and(shr(128, point), 0xffffffff), scalar, M))
                    )
                ),
                shl(96, mulmod(and(shr(96, point), 0xffffffff), scalar, M))
            )
        }
    }

    // Fixed production windows are validated by the external harness before this call.
    function _loadPoint(uint256[] memory point, uint256 i) private pure returns (uint256 v) {
        assembly ("memory-safe") { v := mload(add(add(point, 32), shl(5, i))) }
    }

    function _mulBySelectTermCached(uint256 acc, uint256 pointValue, uint256 scalar)
        internal
        pure
        returns (uint256 out)
    {
        assembly ("memory-safe") {
            let M := 0x78000001
            let mask := 0xffffffff

            let low
            let high
            let c4
            {
                let a0 := shr(224, acc)
                let a1 := and(shr(192, acc), mask)
                let a2 := and(shr(160, acc), mask)
                let a3 := and(shr(128, acc), mask)
                let a4 := and(shr(96, acc), mask)
                let bLow := mload(pointValue)
                let aLow := or(or(a0, shl(64, a1)), or(shl(128, a2), shl(192, a3)))
                c4 := add(
                    shr(192, mul(aLow, mload(add(pointValue, 32)))),
                    mul(a4, and(bLow, 0xffffffff))
                )
                low := mul(aLow, bLow)
                high := mul(
                    or(or(a4, shl(64, a3)), or(shl(128, a2), shl(192, a1))),
                    mload(add(pointValue, 64))
                )
            }
            let laneMask := 0xffffffffffffffff
            let c0 := and(low, laneMask)
            let c1 := and(shr(64, low), laneMask)
            let c2 := and(shr(128, low), laneMask)
            let c3 := shr(192, low)
            let c5 := shr(192, high)
            let c6 := and(shr(128, high), laneMask)
            let c7 := and(shr(64, high), laneMask)
            let c8 := and(high, laneMask)
            out := or(
                or(
                    or(
                        shl(224, mod(add(shr(224, acc), mul(scalar, add(c0, shl(1, c5)))), M)),
                        shl(
                            192,
                            mod(add(and(shr(192, acc), mask), mul(scalar, add(c1, shl(1, c6)))), M)
                        )
                    ),
                    or(
                        shl(
                            160,
                            mod(add(and(shr(160, acc), mask), mul(scalar, add(c2, shl(1, c7)))), M)
                        ),
                        shl(
                            128,
                            mod(add(and(shr(128, acc), mask), mul(scalar, add(c3, shl(1, c8)))), M)
                        )
                    )
                ),
                shl(96, mod(add(and(shr(96, acc), mask), mul(scalar, c4)), M))
            )
        }
    }

    function _cachedAddress(uint256[] memory cache, uint256 index)
        private
        pure
        returns (uint256 ptr)
    {
        assembly ("memory-safe") { ptr := add(add(cache, 32), mul(sub(index, 4), 96)) }
    }

    // All three native windows are suffixes of point[4..22). Cache each point once.
    function prepare(uint256[] memory point) internal pure returns (uint256[] memory cache) {
        assembly ("memory-safe") {
            cache := mload(0x40)
            mstore(cache, 54)
            mstore(0x40, add(cache, 1760))
            let dst := add(cache, 32)
            for { let src := add(point, 160) } lt(src, add(point, 736)) {
                src := add(src, 32)
                dst := add(dst, 96)
            } {
                let b := mload(src)
                let b0 := shr(224, b)
                let b1 := and(shr(192, b), 0xffffffff)
                let b2 := and(shr(160, b), 0xffffffff)
                let b3 := and(shr(128, b), 0xffffffff)
                let b4 := and(shr(96, b), 0xffffffff)
                let low := or(or(b0, shl(64, b1)), or(shl(128, b2), shl(192, b3)))
                mstore(dst, low)
                mstore(add(dst, 32), or(shr(64, low), shl(192, b4)))
                mstore(add(dst, 64), or(or(b4, shl(64, b3)), or(shl(128, b2), shl(192, b1))))
            }
        }
    }

    function _initialCached(uint256 ptr, uint256 scalar) private pure returns (uint256 out) {
        assembly ("memory-safe") {
            let M := 0x78000001
            let low := mload(ptr)
            out := or(
                or(
                    or(
                        shl(224, mod(add(1, mul(and(low, 0xffffffff), scalar)), M)),
                        shl(192, mulmod(and(shr(64, low), 0xffffffff), scalar, M))
                    ),
                    or(
                        shl(160, mulmod(and(shr(128, low), 0xffffffff), scalar, M)),
                        shl(128, mulmod(shr(192, low), scalar, M))
                    )
                ),
                shl(96, mulmod(shr(192, mload(add(ptr, 32))), scalar, M))
            )
        }
    }
}

contract KoalaBearSelectBaselineHarness {
    function term(uint256 a, uint256 b, uint256 scalar) external pure returns (uint256) {
        return KoalaBearSelectBaseline._mulBySelectTermExt5(a, b, scalar);
    }

    function chains(uint256[] memory point, uint256 a, uint256 b, uint256 offset, uint256 n)
        external
        view
        returns (uint256 used, uint256 x, uint256 y)
    {
        require(offset <= point.length && n <= point.length - offset, "POINT");

        uint256 start = gasleft();

        (x, y) = KoalaBearSelectBaseline._selectPolyEvalFixedPair(a, b, point, offset, n);
        used = start - gasleft();
    }

    function single(uint256[] memory point, uint256 a, uint256 offset, uint256 n)
        external
        pure
        returns (uint256)
    {
        require(offset <= point.length && n <= point.length - offset, "POINT");

        return KoalaBearSelectBaseline._selectPolyEvalFixed(a, point, offset, n);
    }

    function batch(
        uint256[] memory point,
        uint256[][3] memory selectors,
        uint256[3] memory challenges,
        uint256[3] memory eqs
    ) external view returns (uint256 used, uint256[3] memory results) {
        require(
            point.length == 22 && selectors[0].length == 38 && selectors[1].length == 31
                && selectors[2].length == 19,
            "SHAPE"
        );
        uint256 start = gasleft();

        results[0] = KoalaBearSelectBaseline._evaluateConstraintSelectRaw18WithPrecomputedEq(
            challenges[0], eqs[0], selectors[0], point
        );
        results[1] = KoalaBearSelectBaseline._evaluateConstraintSelectRaw14WithPrecomputedEq(
            challenges[1], eqs[1], selectors[1], point
        );
        results[2] = KoalaBearSelectBaseline._evaluateConstraintSelectRaw10WithPrecomputedEq(
            challenges[2], eqs[2], selectors[2], point
        );
        used = start - gasleft();
    }
}

